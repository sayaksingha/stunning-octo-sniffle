define b1 X [
	box height h width w / 32
	] X

SRC: b16 "source"
DST: b16 with .nw at SRC.ne "dest"

LEN: b16 with .nw at SRC.sw "len"
CKSM: b16 with .w at LEN.e "cksm"

arc from CKSM.se to DST.ne radius .15i
move to DST.se + (w / 32 * 3, 0)
"UDP"

CID: b32 with .nw at LEN.sw "cid"

SEQ: b32 with .nw at CID.sw "SEQ"

ACK: b32 with .nw at SEQ.sw "ACK"

TXTS: b32 with .nw at ACK.sw "TXTS"

REFTS: b32 with .nw at TXTS.sw "REFTS"

ECE: b1 with .nw at REFTS.sw "E" "C" "E"
CWR: b1 with .w at ECE.e "C" "W" "R"
NS: b1 with .w at CWR.e "N" "S"
RES: b13 with .w at NS.e "reserved"
OPTLEN: b16 with .w at RES.e "OPTLEN"

OPT: b16 with .nw at ECE.sw "OPT"
COPT: [ box height h width w/32 invis ] with .nw at OPT.nw "C"
SOPT: [ box height h width w/32 invis ] with .w at COPT.e "S"
OPTDATA: b16 with .w at OPT.e "OPTDATA..."

box height h * 4 width w with .nw at OPT.sw "user data"

arc from OPTDATA.se to OPTLEN.ne radius .2i
move to OPTLEN.se + (w / 32, 0)
"*"

.PE

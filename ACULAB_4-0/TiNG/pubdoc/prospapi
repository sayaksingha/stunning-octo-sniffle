apifn	sm_add_input_cptone
params	sm_input_cptone_parms cptonep
	The module whose call-progress tone set is to be modified.
field	tSMModuleId module in
	The number of entries in the
ref	states
	field.
field	tSM_INT state_count in
	The sequence of component states representing this tone. The
	last to occur must be in <code>states[0]</code>, and the first
	must be in <code>states[state_count-1]</code> - they are in the
	opposite order in this array to the order they occur in the
	incoming signal.
struct	sm_cptone_state
	The id of a component tone.
field	tSM_INT freq_id in
	The minimum duration (in mS) of this component.
field	tSM_INT maximum_cadence in
	The maximum duration (in mS) of this component.
field	tSM_INT minimum_cadence in
const	kSMMaxCPToneStates 16
unstruct	states[kSMMaxCPToneStates]	input_cptone
	The identifier of this call-progress tone.

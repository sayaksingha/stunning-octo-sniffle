apifn	smdc_rx_control
params	smdc_rx_control_parms controlp
	The data communication channel.
field	tSMChannelId channel in
	The operations to perform.
enumstart	kSMDCRxCtl
	Discard any buffered data not yet collected.
enum	kSMDCRxCtlDiscard
	Set the criteria for determining when the input half of the
	channel is ready.
enum	kSMDCRxCtlNotifyOnData
	Use any flow control mechanism available in the configured
	protocol to stop the incoming data flow.
